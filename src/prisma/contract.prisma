// use prisma-8

// ═══════════════════════════════════════════════════════════════════
// Speaker Platform — nền tảng trung gian mua bán & trao đổi loa
// Tiền tệ: VND (số nguyên, không có phần thập phân)
// ═══════════════════════════════════════════════════════════════════

// ─── Enums ───

enum user_role {
  @@type("pg/text@1")
  buyer  = "buyer"
  seller = "seller"
  admin  = "admin"
}

enum listing_status {
  @@type("pg/text@1")
  draft    = "draft"    // nháp
  pending  = "pending"  // chờ admin duyệt
  approved = "approved" // đã duyệt, đang hiển thị
  rejected = "rejected" // bị từ chối
  hidden   = "hidden"   // người bán tự ẩn
  sold     = "sold"     // đã bán
  // Trong enum HIỆN CÓ — THÊM MỘT value (R2: Batch 3 là first writer của
  // `removed`; Batch 4 Task 1 chỉ thêm `archived`, KHÔNG đụng `removed` — additive-only):
  removed  = "removed"  // moderation takedown (R4) — KHÔNG dùng cho seller self-hide
  archived = "archived" // §5.6.2 lifecycle — reserved, chưa có transition nào trong P0 (Batch 4 thêm)
}

enum product_condition {
  @@type("pg/text@1")
  new        = "new"         // mới nguyên seal
  open_box   = "open_box"    // mở hộp chưa dùng
  like_new   = "like_new"    // gần mới
  excellent  = "excellent"    // rất tốt
  good       = "good"        // còn tốt
  fair       = "fair"        // cũ, còn dùng tốt
  refurbished = "refurbished" // đã tái chế / sửa chữa chính hãng
  for_parts  = "for_parts"   // lấy linh kiện
}

enum order_status {
  @@type("pg/text@1")
  awaiting_payment = "awaiting_payment" // chờ buyer thanh toán
  paid_escrow      = "paid_escrow"      // tiền đã vào escrow, chờ seller gửi hàng
  processing       = "processing"      // seller xác nhận, chuẩn bị hàng
  shipped          = "shipped"          // đã gửi hàng
  completed        = "completed"        // hoàn tất — đã giải ngân cho seller
  cancelled        = "cancelled"        // đã hủy
  refunded         = "refunded"        // đã hoàn tiền cho buyer
  disputed         = "disputed"         // có khiếu nại
}

enum payment_method {
  @@type("pg/text@1")
  escrow = "escrow" // thanh toán qua nền tảng (giữ tiền hộ)
  direct = "direct" // chuyển khoản trực tiếp cho seller
  cod    = "cod"    // trả tiền khi nhận hàng
}

enum payment_status {
  @@type("pg/text@1")
  pending   = "pending"    // đang chờ
  held      = "held"       // escrow đang giữ tiền
  released  = "released"   // đã giải ngân cho seller
  refunded  = "refunded"   // đã hoàn cho buyer
  failed    = "failed"
}

enum exchange_status {
  @@type("pg/text@1")
  proposed  = "proposed"  // buyer gửi đề nghị
  accepted  = "accepted"  // seller đồng ý, chờ tiền bù vào escrow
  paid      = "paid"      // tiền bù đã vào escrow
  completed = "completed" // hoàn tất trao đổi
  rejected  = "rejected"
  cancelled = "cancelled"
}

enum dispute_status {
  @@type("pg/text@1")
  open            = "open"
  resolved_buyer  = "resolved_buyer"  // xử lý nghiêng về buyer (hoàn tiền)
  resolved_seller = "resolved_seller" // xử lý nghiêng về seller (giải ngân)
  closed          = "closed"
}

// ─── Enums (Batch 2 — identity & security) ───

enum admin_role {
  @@type("pg/text@1")
  super_admin      = "super_admin"
  operations_admin = "operations_admin"
  moderator        = "moderator"
  support          = "support"
  analyst          = "analyst"
}

enum seller_type {
  @@type("pg/text@1")
  individual = "individual"
  business    = "business"
}

enum seller_verification_status {
  @@type("pg/text@1")
  not_started  = "not_started"
  pending      = "pending"
  verified     = "verified"
  rejected     = "rejected"
  needs_review = "needs_review"
  revoked      = "revoked"
}

enum seller_verification_method {
  @@type("pg/text@1")
  operations_review = "operations_review"
}

enum otp_purpose {
  @@type("pg/text@1")
  email_verification = "email_verification"
  phone_verification  = "phone_verification"
  password_recovery    = "password_recovery"
}

enum otp_channel {
  @@type("pg/text@1")
  email = "email"
  phone = "phone"
}

enum beta_cohort {
  @@type("pg/text@1")
  internal           = "internal"
  founding_seller    = "founding_seller"
  private_beta_buyer = "private_beta_buyer"
}

enum beta_membership_status {
  @@type("pg/text@1")
  invited   = "invited"
  active    = "active"
  suspended = "suspended"
  exited    = "exited"
}

// ─── Enums (Batch 3 — trust & safety, spec §5.5/§5.5.1) ───

enum report_target_type {
  @@type("pg/text@1")
  listing = "listing"
  user    = "user"
  message = "message"
}

enum report_reason {
  @@type("pg/text@1")
  suspected_scam         = "suspected_scam"
  harassment             = "harassment"
  spam                   = "spam"
  counterfeit_claim      = "counterfeit_claim"
  misleading_listing     = "misleading_listing"
  prohibited_content     = "prohibited_content"
  unsafe_behavior        = "unsafe_behavior"
  identity_impersonation = "identity_impersonation"
  other                  = "other"
}

enum moderation_case_state {
  @@type("pg/text@1")
  open          = "open"
  triaged       = "triaged"
  investigating = "investigating"
  actioned      = "actioned"
  dismissed     = "dismissed"
  appealed      = "appealed"
  closed        = "closed"
}

enum moderation_priority {
  @@type("pg/text@1")
  low    = "low"
  normal = "normal"
  high   = "high"
}

enum suspension_status {
  @@type("pg/text@1")
  active = "active"
  lifted = "lifted"
}

enum appeal_state {
  @@type("pg/text@1")
  submitted = "submitted"
  closed    = "closed"
}

// ─── Enums (Batch 4 — listing quality, spec §5.6) ───

enum inventory_context {
  @@type("pg/text@1")
  new      = "new"       // mới / nguyên seal
  open_box = "open_box"  // mở hộp chưa dùng
  used     = "used"      // đã qua sử dụng
}

// ─── Enums (Batch 5 — location source & search alias, spec §5.9/§5.7) ───

enum listing_location_source {
  @@type("pg/text@1")
  seller_declared = "seller_declared" // submission mang mã tỉnh hợp lệ do Batch 4 form ghi (S4)
  legacy_mapped   = "legacy_mapped"   // backfill khớp qua BẢNG ĐÃ DUYỘT của registry (FD-1) — không phải name-equality (spec §8.3)
  unresolved      = "unresolved"      // legacy không nằm trong danh sách tên authoritative của registry → KHÔNG đoán (FD-1)
}

enum search_alias_target {
  @@type("pg/text@1")
  brand = "brand"
  model = "model"
}

// ─── Enums (Batch 6 — Deal, spec §5.2) ───

enum deal_status {
  @@type("pg/text@1")
  open      = "open"       // thỏa thuận đã tạo, chưa có kết quả song phương
  completed = "completed"  // CẢ HAI bên xác nhận thành công (bilateral — §5.2)
  cancelled = "cancelled"  // thỏa thuận bị hủy sau khi đã thống nhất
  no_deal   = "no_deal"    // không đạt thỏa thuận
}

enum deal_fulfillment_method {
  @@type("pg/text@1")
  meetup          = "meetup"           // gặp trực tiếp
  seller_delivery = "seller_delivery"   // người bán giao đến
  carrier         = "carrier"           // chuyển phát
  other           = "other"             // khác
}

// ─── Người dùng & danh mục ───

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         user_role @default(buyer)
  avatarUrl    String?
  city         String?
  bio          String?
  isVerifiedSeller Boolean @default(false) // đã xác minh để nhận giải ngân
  // ─── Batch 2 — identity & security (additive, spec §8.2/§8.5) ───
  emailVerifiedAt              TimestamptzString? // trạng thái xác minh email (spec §5.3)
  phoneVerifiedAt              TimestamptzString? // trạng thái xác minh phone (spec §5.3)
  adminRole                    admin_role? // nguồn duy nhất cho admin authorization (spec §8.5); role chỉ còn display
  sellerType                   seller_type? // khai báo individual/business (spec §5.3.3)
  sellerOperatingProvinceCode String? // mã hành chính VN nơi hoạt động (spec §5.9)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  listings           Listing[]
  buyerOrders         Order[]         @relation("buyer_orders")
  sellerOrders        Order[]         @relation("seller_orders")
  payouts            Payout[]        @relation("payout_seller")
  exchangeOffersMade ExchangeOffer[] @relation("exchange_buyer")
  buyerConversations Conversation[]  @relation("convo_buyer")
  sellerConversations Conversation[] @relation("convo_seller")
  sentMessages        Message[]      @relation("message_sender")
  reviewsGiven        Review[]       @relation("review_author")
  reviewsReceived     Review[]       @relation("review_target")
  disputesOpened      Dispute[]      @relation("dispute_opener")
  auditLogs           AdminAuditLog[] @relation("audit_admin")
  wishlist            WishlistItem[] @relation("wishlist_owner")
  withdrawRequests     WithdrawRequest[] @relation("withdraw_seller")
  processedWithdraws  WithdrawRequest[] @relation("withdraw_admin")
  offersMade          Offer[] @relation("offer_buyer")
  notifications       Notification[] @relation("notification_user")
  // ─── Batch 2 — relations (additive) ───
  sessions            UserSession[]          @relation("session_user")
  otpCodes            OtpCode[]              @relation("otp_user")
  sellerVerification  SellerVerification?    @relation("seller_verification_user")
  betaMemberships     BetaCohortMembership[]  @relation("beta_membership_user")
  policyAcceptances   PolicyAcceptance[]     @relation("policy_acceptance_user")
  adminMfa            AdminMfa?              @relation("admin_mfa_user")
  auditEventsActor    AuditEvent[]           @relation("audit_event_actor")
  auditEventsSubject  AuditEvent[]           @relation("audit_event_subject")
  // ─── Batch 3 — trust & safety relations (additive — KHÔNG cột mới trên User) ───
  reportsMade          AbuseReport[]        @relation("abuse_report_reporter")
  casesAssigned        ModerationCase[]     @relation("moderation_case_assignee")
  evidenceSubject      ModerationEvidence[] @relation("moderation_evidence_subject")
  evidenceReporter     ModerationEvidence[] @relation("moderation_evidence_reporter")
  moderationActions    ModerationAction[]   @relation("moderation_action_actor")
  blocksMade           UserBlock[]          @relation("user_block_blocker")
  blocksReceived       UserBlock[]          @relation("user_block_blocked")
  suspensions          UserSuspension[]     @relation("user_suspension_user")
  suspensionsActedBy   UserSuspension[]     @relation("user_suspension_actor")
  suspensionsLiftedBy  UserSuspension[]     @relation("user_suspension_lifter")
  appealsFiled         Appeal[]             @relation("appeal_appellant")
  // ─── Batch 4 — upload ownership relation (additive — spec §5.6.4) ───
  imageUploads         ListingImageUpload[] @relation("listing_image_upload_owner")
  // ─── Batch 6 — Deal relations (additive — KHÔNG cột mới trên User, spec §5.2) ───
  dealsAsBuyer        Deal[]              @relation("deal_buyer")
  dealsAsSeller       Deal[]              @relation("deal_seller")
  dealHistoryActions  DealStatusHistory[] @relation("deal_history_actor")

  @@index([role])
}

model Category {
  id             String  @id @default(uuid())
  name           String
  slug           String  @unique
  description    String?
  icon           String?
  commissionRate Int     @default(5) // % hoa hồng nền tảng thu trên giao dịch
  sortOrder      Int     @default(0)
  isActive       Boolean @default(true)
  createdAt      TimestamptzString @default(now())

  listings Listing[]
  models   ProductModel[] @relation("model_category")

  @@index([sortOrder])
}

model Brand {
  id        String  @id @default(uuid())
  name      String
  slug      String  @unique
  logoUrl   String?
  createdAt TimestamptzString @default(now())

  listings Listing[]
  models   ProductModel[] @relation("model_brand")
  // ─── Batch 5 — search alias back-relation (additive, spec §5.7) ───
  searchAliases SearchAlias[] @relation("alias_brand")
}

// ─── Tin đăng ───

model Listing {
  id          String   @id @default(uuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brandId     String?
  brand       Brand?   @relation(fields: [brandId], references: [id])
  title       String
  slug        String   @unique
  description String
  condition   product_condition
  price       Int // VND
  negotiable  Boolean @default(false) // có thương lượng giá
  acceptExchange Boolean @default(false) // sẵn sàng trao đổi
  status      listing_status @default(pending)
  rejectionReason String?
  city        String
  viewCount   Int @default(0)
  createdAt   TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  images         ListingImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  targetOffers   ExchangeOffer[] @relation("exchange_target")
  offeredIn      ExchangeOffer[] @relation("exchange_mine")
  conversations Conversation[]
  wishlistedBy   WishlistItem[]
  priceOffers    Offer[] @relation("offer_listing")
  productModelId String?
  productModel   ProductModel? @relation(fields: [productModelId], references: [id])
  // ─── Batch 6 — Deal back-relation (additive — KHÔNG cột mới trên Listing, spec §5.2) ───
  deals Deal[] @relation("deal_listing")

  // ─── Batch 4 — structured portable-speaker listing (spec §5.6) ───
  inventoryContext     inventory_context? // NULL = legacy "not captured" (spec §8.3)
  includedAccessories  String?           // ≤2000 ký tự (schema)
  knownDefects         String?           // ≤2000 ký tự (schema)
  repairHistory        String?           // ≤2000 ký tự (schema)
  fulfillmentMethods   Json?              // ("meetup"|"seller_delivery"|"carrier"|"other")[] — zod-validated tại boundary
  provinceLevelCode    String?           // slug code tỉnh/thành — 34 đơn vị, src/lib/provinces.ts (FD-1: NQ 202/2025/QH15)
  communeLevelCode      String?           // reserved — Batch 5 location model populate
  locationDisplayName  String?           // hiển thị thô — KHÔNG phải địa chỉ nhà riêng (spec §5.6)

  // ─── Batch 4 holistic (round 2) — review version của content ───
  // Ngày-giờ admin duyệt content HIỆN TẠI (ghi trong tx của approveListingAction;
  // hide/show KHÔNG đụng). toggleListingVisibilityAction hidden→show đọc cột:
  // SET ⇒ content đã được duyệt (Batch 4 mọi content-change trên hidden → pending)
  // → hiện lại approved; NULL ⇒ row pre-Batch-4 edit-while-hidden / chưa bao giờ
  // approved → hiện lại PENDING (admin duyệt lại một lần — fail-closed).
  approvedContentAt     TimestamptzString?

  // ─── Batch 5 (spec §5.9): nguồn của location canonical — cột mã tỉnh thuộc Batch 4 (S3/S4) ───
  locationSource      listing_location_source? // null = chưa backfill; sau backfill không còn null trên legacy row

  // ─── Batch 5 (spec §5.7): normalized search text — derived, luôn tính lại được ───
  searchTextNormalized String? // normalizeSearchText(title + brand.name + model.name) — Task 4 duy trì + backfill

  @@index([status, createdAt])
  @@index([categoryId])
  @@index([brandId])
  @@index([sellerId])
  @@index([price])
  @@fullTextIndex([title], name: "listing_title_search")
  @@fullTextIndex([description], name: "listing_desc_search")
  // language "simple" ở CẢ HAI phía index + query (S-1) — english stopword/stemmer
  // làm hỏng text tiếng Việt đã pre-normalize ("loa do" mất "do"); cú pháp PSL
  // theo .agents/skills/prisma-8/references/contract.md § Full-text search indexes
  @@fullTextIndex([searchTextNormalized], name: "listing_search_text_search", language: "simple")
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int @default(0)
  checklistSlot String? // §5.6.3: front|back|control_panel|ports|damage|accessories|box|label_serial — NULL = legacy/không gán slot

  @@index([listingId])
}

// ─── Giỏ hàng ───

model Cart {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt TimestamptzString @default(now())

  items CartItem[]
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  quantity  Int @default(1)

  @@unique([cartId, listingId])
}

// ─── Đơn hàng & thanh toán ───

model Order {
  id               String @id @default(uuid())
  code             String @unique // mã đơn hiển thị, vd SP-240930-0001
  buyerId          String
  buyer            User   @relation("buyer_orders", fields: [buyerId], references: [id])
  sellerId         String
  seller           User   @relation("seller_orders", fields: [sellerId], references: [id])
  status           order_status @default(awaiting_payment)
  totalAmount      Int // tổng tiền hàng
  commissionRate   Int // % hoa hồng snapshot tại thời điểm đặt
  commissionAmount Int // tiền hoa hồng nền tảng thu
  sellerPayout     Int // tiền thực nhận của seller sau trừ hoa hồng
  paymentMethod    payment_method
  shippingAddress  String
  shippingPhone    String
  note             String?
  escrowReleasedAt TimestamptzString? // thời điểm giải ngân
  autoReleaseAt    TimestamptzString? // tự giải ngân sau N ngày nếu không khiếu nại
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  items    OrderItem[]
  payments Payment[]
  payout   Payout?
  review   Review?
  disputes Dispute[]
  statusHistory OrderStatusHistory[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  title     String // snapshot tiêu đề
  price     Int // snapshot giá
  imageUrl  String? // snapshot ảnh đầu
  quantity  Int @default(1)

  @@index([orderId])
}

model Payment {
  id              String @id @default(uuid())
  orderId         String?
  order           Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  exchangeOfferId String? @unique
  exchangeOffer   ExchangeOffer? @relation("exchange_payment", fields: [exchangeOfferId], references: [id])
  method          payment_method
  status          payment_status @default(pending)
  amount          Int
  provider        String @default("mock") // vnpay / momo / bank_qr / manual
  providerTxnId   String? // mã giao dịch từ cổng
  createdAt       TimestamptzString @default(now())
  paidAt          TimestamptzString?
  releasedAt      TimestamptzString? // thời điểm giải ngân cho seller

  @@index([orderId])
  @@index([status])
}

model Payout {
  id        String @id @default(uuid())
  orderId   String? @unique
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User   @relation("payout_seller", fields: [sellerId], references: [id])
  amount    Int // tiền seller nhận được
  status    payment_status @default(released)
  createdAt TimestamptzString @default(now())

  @@index([sellerId])
}

// ─── Trao đổi (đổi loa + tiền bù) ───

model ExchangeOffer {
  id                 String @id @default(uuid())
  listingId          String // tin đăng người bán — mục tiêu trao đổi
  listing            Listing @relation("exchange_target", fields: [listingId], references: [id], onDelete: Cascade)
  buyerId            String
  buyer              User    @relation("exchange_buyer", fields: [buyerId], references: [id])
  myListingId        String? // tin đăng của buyer đưa ra đổi (nếu có)
  // Batch 4 holistic (round 2) — RECORDED DEFERRAL: onDelete: SetNull cho FK
  // exchange_mine là "complete fix" cho race offer-xen-giữa-check-và-DELETE,
  // nhưng planner từ chối FK onDelete change (MIGRATION.PLANNING_FAILED —
  // phải migration new tay) VÀ race unreachable hôm nay (offer MỚI bị
  // assertFinancialFeaturesEnabled chặn — finance flag off; chỉ dữ liệu
  // TỒN TẠI pre-Batch-4). deleteListingAction pre-check myListingId (ẩn/
  // LISTING_HAS_ORDERS) là fix chính; SetNull đăng ký follow-up khi finance
  // bật lại (lúc đó offer mới có thể xen giữa check và DELETE).
  myListing          Listing? @relation("exchange_mine", fields: [myListingId], references: [id])
  myItemDescription String? // mô tả sản phẩm đưa ra đổi nếu không có tin đăng
  cashTopup          Int @default(0) // tiền bù (VND)
  message            String?
  status             exchange_status @default(proposed)
  commissionRate     Int @default(5) // hoa hồng tính trên tiền bù
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  payment Payment? @relation("exchange_payment")

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
}

// ─── Chat ───

model Conversation {
  id            String @id @default(uuid())
  listingId     String?
  listing       Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId       String
  buyer         User @relation("convo_buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User @relation("convo_seller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt     TimestamptzString @default(now())
  lastMessageAt TimestamptzString?

  messages Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User @relation("message_sender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  imageUrl       String?
  readAt         TimestamptzString?
  createdAt      TimestamptzString @default(now())

  @@index([conversationId, createdAt])
}

// ─── Đánh giá & khiếu nại ───

model Review {
  id           String @id @default(uuid())
  orderId      String @unique
  order        Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  authorId     String
  author       User @relation("review_author", fields: [authorId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User @relation("review_target", fields: [targetUserId], references: [id], onDelete: Cascade)
  rating       Int // 1–5 sao
  comment      String?
  createdAt     TimestamptzString @default(now())

  @@index([targetUserId])
}

model Dispute {
  id          String @id @default(uuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  openedById   String
  openedBy     User @relation("dispute_opener", fields: [openedById], references: [id], onDelete: Cascade)
  status      dispute_status @default(open)
  reason      String
  resolution  String?
  createdAt    TimestamptzString @default(now())
  resolvedAt   TimestamptzString?

  @@index([orderId])
  @@index([status])
}

// ─── Cấu hình nền tảng ───

model PlatformSetting {
  key       String @id
  value     String
  updatedAt temporal.updatedAtString()
}

model AdminAuditLog {
  id        String @id @default(uuid())
  adminId   String
  admin     User @relation("audit_admin", fields: [adminId], references: [id], onDelete: Cascade)
  action    String // approve_listing / reject_listing / resolve_dispute / ...
  entity    String
  entityId   String?
  detail     String?
  createdAt  TimestamptzString @default(now())

  @@index([createdAt])
}

// ─── Wishlist / tin đã lưu (§28) ───

model WishlistItem {
  id        String @id @default(uuid())
  userId    String
  user      User @relation("wishlist_owner", fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt TimestamptzString @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// ─── Lịch sử trạng thái đơn (§48 — audit trail chuyển trạng thái) ───

model OrderStatusHistory {
  id        String @id @default(uuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    order_status
  note      String?
  actorId   String? // người thực hiện chuyển (buyer/seller/system)
  createdAt TimestamptzString @default(now())

  @@index([orderId, createdAt])
}

// ─── Rút tiền của người bán (§120 Seller Payout) ───

enum withdraw_status {
  @@type("pg/text@1")
  requested  = "requested"  // seller gửi yêu cầu
  processing  = "processing"  // admin đang chuyển khoản
  paid        = "paid"        // đã chuyển khoản thành công
  rejected    = "rejected"    // từ chối (thiếu thông tin, sai stk…)
}

model WithdrawRequest {
  id            String @id @default(uuid())
  sellerId      String
  seller        User   @relation("withdraw_seller", fields: [sellerId], references: [id])
  amount        Int // VND
  status        withdraw_status @default(requested)
  bankName      String
  bankAccount   String // số tài khoản
  accountHolder String // tên chủ khoản
  note          String? // ghi chú từ seller
  adminNote     String? // phản hồi của admin
  processedById String? // admin xử lý
  processedBy   User?  @relation("withdraw_admin", fields: [processedById], references: [id])
  processedAt   TimestamptzString?
  createdAt     TimestamptzString @default(now())

  @@index([sellerId, createdAt])
  @@index([status])
}

// ─── Trả giá / Offer (§13 Offer & Negotiation) ───

enum offer_status {
  @@type("pg/text@1")
  proposed  = "proposed"   // buyer đề nghị
  countered = "countered"   // seller phản đề nghị
  accepted  = "accepted"    // seller chấp nhận → tạo đơn
  rejected  = "rejected"    // seller từ chối
  cancelled = "cancelled"   // buyer rút đề nghị
  expired   = "expired"     // quá hạn không phản hồi
}

model Offer {
  id            String @id @default(uuid())
  listingId     String
  listing       Listing @relation("offer_listing", fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User    @relation("offer_buyer", fields: [buyerId], references: [id])
  amount        Int // giá buyer đề nghị (VND)
  counterAmount Int? // giá seller phản đề nghị
  message       String?
  status        offer_status @default(proposed)
  orderId       String? // đơn tạo ra khi chấp nhận
  expiresAt     TimestamptzString // hạn phản hồi (mặc định 3 ngày)
  respondedAt   TimestamptzString?
  createdAt     TimestamptzString @default(now())

  @@index([listingId, status])
  @@index([buyerId, createdAt])
}

// ─── Canonical Product Model (§5 — tách model khỏi listing) ───

enum model_status {
  @@type("pg/text@1")
  approved = "approved" // hiển thị trong catalog
  pending  = "pending"  // chờ admin duyệt
  merged   = "merged"    // đã gộp vào model khác
}

model ProductModel {
  id          String @id @default(uuid())
  brandId     String
  brand       Brand @relation("model_brand", fields: [brandId], references: [id])
  categoryId  String
  category    Category @relation("model_category", fields: [categoryId], references: [id])
  name        String // "Charge 5"
  slug        String @unique // "jbl-charge-5"
  releaseYear Int?
  description String?
  specs       Json? // specs chuẩn hóa
  image       String?
  status      model_status @default(pending)
  mergedIntoId String? // khi merged → trỏ model gốc
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  listings     Listing[]
  priceHistory PriceHistory[]
  // ─── Batch 5 — search alias back-relation (additive, spec §5.7) ───
  searchAliases SearchAlias[] @relation("alias_model")

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@fullTextIndex([name], name: "model_name_search")
}

enum price_kind {
  @@type("pg/text@1")
  listed  = "listed"    // giá niêm yết khi đăng tin
  sold    = "sold"      // giá bán thành công thực tế
  reprice = "reprice"   // thay đổi giá
}

model PriceHistory {
  id        String @id @default(uuid())
  modelId   String
  model     ProductModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  listingId String? // tin đăng gây ra record giá
  price     Int
  kind      price_kind
  createdAt TimestamptzString @default(now())

  @@index([modelId, createdAt])
}

// ─── Double-entry ledger (§17 — immutable, mọi dòng tiền ghi vết) ───

model LedgerEntry {
  id        String @id @default(uuid())
  txId      String // các entry đối xứng thuộc cùng giao dịch
  account   String // escrow | platform_revenue | seller:<id> | withdraw
  amount    Int // dương = credit (ghi có), âm = debit (ghi nợ)
  refType   String // order | payment | payout | withdraw | exchange | refund
  refId      String?
  note      String?
  createdAt TimestamptzString @default(now())

  @@index([txId])
  @@index([account, createdAt])
}

// ─── Notifications (§42) ───

model Notification {
  id        String @id @default(uuid())
  userId    String
  user      User @relation("notification_user", fields: [userId], references: [id], onDelete: Cascade)
  kind      String // offer | counter | order | dispute | chat | price_drop
  title     String
  body      String?
  link      String?
  readAt    TimestamptzString?
  createdAt TimestamptzString @default(now())

  @@index([userId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Batch 2 — Identity & Security (spec §5.3/§5.4/§2.1/§4.6)
// Additive-only: không drop/rename/repurpose model/cột nào đang có.
// ═══════════════════════════════════════════════════════════════════

// ─── Session (Batch 2 — DB-backed, spec §5.4.2) ───

model UserSession {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("session_user", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String            @unique // sha256 của token opaque — lookup, không phải secrecy
  isAdmin       Boolean           @default(false) // TTL admin ngắn hơn (Task 2)
  createdAt     TimestamptzString @default(now())
  lastSeenAt    TimestamptzString?
  expiresAt     TimestamptzString
  revokedAt     TimestamptzString?
  revokedReason String?
  steppedUpAt   TimestamptzString? // step-up cho hành động nhạy cảm (Task 8)
  userAgent     String?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// ─── OTP (Batch 2 — spec §5.3: hashed, single-use, short-lived) ───

model OtpCode {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation("otp_user", fields: [userId], references: [id], onDelete: Cascade)
  purpose    otp_purpose
  channel    otp_channel
  target     String            // email/phone đã chuẩn hóa — mã chỉ hợp lệ cho đúng target
  codeHash   String            // HMAC-SHA256 keyed — không lưu mã thô
  attempts   Int               @default(0)
  expiresAt  TimestamptzString
  consumedAt TimestamptzString? // single-use — set khi verify thành công
  createdAt  TimestamptzString @default(now())

  @@index([userId, purpose, createdAt])
  @@index([target, purpose, createdAt])
  @@index([expiresAt])
}

// ─── Seller verification (spec §5.3.2 — workflow, không phải boolean) ───

model SellerVerification {
  id            String                     @id @default(uuid())
  userId        String                     @unique
  user          User                       @relation("seller_verification_user", fields: [userId], references: [id])
  status        seller_verification_status @default(pending)
  method        seller_verification_method @default(operations_review)
  submittedAt   TimestamptzString?
  reviewedAt    TimestamptzString?
  reviewerId    String?
  reasonCode    String? // typed reason code (spec §5.3.3) — không free text tuỳ ý
  note          String?
  policyVersion String // "v1" — policy version khi ra quyết định
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([status, updatedAt])
}

// ─── Beta cohort (spec §2.1 — membership là điều kiện publication) ───

model BetaCohortMembership {
  id         String                 @id @default(uuid())
  userId     String
  user       User                   @relation("beta_membership_user", fields: [userId], references: [id], onDelete: Cascade)
  cohort     beta_cohort
  status     beta_membership_status @default(invited)
  invitedBy  String?
  invitedAt  TimestamptzString?
  acceptedAt TimestamptzString?
  expiresAt  TimestamptzString?
  notes      String?
  createdAt  TimestamptzString      @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([userId, cohort])
  @@index([cohort, status])
}

// ─── Policy acceptance (spec §3.1 legal — cơ chế ghi nhận, văn bản thuộc Batch 8) ───

model PolicyAcceptance {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("policy_acceptance_user", fields: [userId], references: [id], onDelete: Cascade)
  policyKey     String            // "seller_rules"
  policyVersion String            // "v1"
  acceptedAt    TimestamptzString  @default(now())

  @@unique([userId, policyKey, policyVersion])
  @@index([userId, policyKey])
}

// ─── Admin MFA (spec §5.3/§5.4.2 — TOTP + mã khôi phục dùng một lần) ───

model AdminMfa {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation("admin_mfa_user", fields: [userId], references: [id], onDelete: Cascade)
  totpSecretEnc   String            // AES-256-GCM envelope "v1:<keyId>:<iv‖tag‖ct>"; key = ADMIN_MFA_ENCRYPTION_KEY (env riêng, không phải AUTH_SECRET)
  totpConfirmedAt TimestamptzString?
  createdAt       TimestamptzString  @default(now())
  updatedAt       temporal.updatedAtString()

  recoveryCodes   AdminRecoveryCode[]
}

model AdminRecoveryCode {
  id        String            @id @default(uuid())
  mfaId     String
  mfa       AdminMfa          @relation(fields: [mfaId], references: [id], onDelete: Cascade)
  codeHash  String            // HMAC keyed — không lưu mã thô
  usedAt    TimestamptzString? // single-use
  createdAt TimestamptzString @default(now())

  @@index([mfaId, usedAt])
}

// ─── Audit foundation (spec §4.6 — actor/action/resource/reason/context/policy) ───

model AuditEvent {
  id            String            @id @default(uuid())
  actorId       String?
  actor         User?             @relation("audit_event_actor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectId     String?
  subject       User?             @relation("audit_event_subject", fields: [subjectId], references: [id], onDelete: SetNull)
  action        String            // typed, dot-namespaced: "seller_verification.reviewed" | "session.revoked" | ...
  resourceType  String?
  resourceId    String?
  reason        String?           // typed reason code
  policyVersion String?
  sessionId     String?
  ipHash        String?           // HMAC keyed — không lưu IP thô (spec §4.8)
  detail        String?           // KHÔNG chứa PII thô/OTP/secret (spec §4.8)
  createdAt     TimestamptzString @default(now())

  @@index([actorId, createdAt])
  @@index([subjectId, createdAt])
  @@index([action, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Batch 3 — Trust & Safety (spec §5.5/§5.5.1/§7.8/§9 Batch 3)
// Additive-only: không drop/rename/repurpose model/cột/enum value nào đang có.
// ═══════════════════════════════════════════════════════════════════

// ─── Abuse report (spec §5.5 — typed reason + case linkage) ───

model AbuseReport {
  id         String             @id @default(uuid())
  reporterId String?            // nullable + SetNull: report row sống qua account deletion (A3)
  reporter    User?             @relation("abuse_report_reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType report_target_type
  targetId   String
  reasonCode report_reason
  note       String?            // mô tả thêm của người báo cáo — untrusted input, cap ở action layer
  caseId     String
  moderationCase ModerationCase @relation(fields: [caseId], references: [id])
  createdAt  TimestamptzString @default(now())

  @@unique([caseId, reporterId])   // một report/reporter/case — dedupe race-safe (Task 4)
  @@index([reporterId, createdAt])
  @@index([targetType, targetId])
  @@index([caseId, createdAt])
}

// ─── Moderation case (spec §5.5 — grouping + workflow) ───

model ModerationCase {
  id                  String                 @id @default(uuid())
  targetType           report_target_type
  targetId            String
  state               moderation_case_state  @default(open)
  priority             moderation_priority    @default(normal)
  assignedModeratorId String?
  assignedModerator   User?                  @relation("moderation_case_assignee", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  reasonCategory      report_reason
  createdAt           TimestamptzString     @default(now())
  updatedAt           temporal.updatedAtString()

  reports  AbuseReport[]
  evidence ModerationEvidence[]
  actions  ModerationAction[]
  appeal   Appeal?              // one-to-one: Appeal.caseId @unique

  @@index([state, updatedAt])
  @@index([targetType, targetId])
  @@index([assignedModeratorId])
  // một case active duy nhất per (target, reason) — đóng race find-or-create (Task 4);
  // cú pháp where:/unique: theo .agents/skills/prisma-8/references/contract.md §index attributes
  @@index([targetType, targetId, reasonCategory], where: "(state IN ('open', 'triaged', 'investigating'))", unique: true, name: "moderation_case_one_active_per_target_reason")
}

// ─── Evidence (spec §5.5.1) — immutable from product flows; SetNull FKs để
// evidence sống qua account deletion tương lai (A3); KHÔNG BAO GIỜ update/delete từ app flow. ───

model ModerationEvidence {
  id                 String            @id @default(uuid())
  caseId             String
  moderationCase     ModerationCase    @relation(fields: [caseId], references: [id])
  sourceResourceType String            // "listing" | "user" | "message"
  sourceResourceId   String
  capturedAt         TimestamptzString @default(now())
  relevantSnapshot    Json              // snapshot JSON tại thời điểm báo cáo — immutable
  subjectUserId      String?
  subject            User?             @relation("moderation_evidence_subject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  reporterUserId     String?
  reporter           User?             @relation("moderation_evidence_reporter", fields: [reporterUserId], references: [id], onDelete: SetNull)
  classification     String            // reason category tại thời điểm capture

  @@index([caseId, capturedAt])
  // name: tường minh — prefix mặc định ModerationEvidence_sourceResourceType_sourceResourceId_idx
  // (57B) vượt giới hạn 54B của wire name (63B identifier − 9B hash suffix)
  @@index([sourceResourceType, sourceResourceId], name: "moderation_evidence_source_idx")
}

// ─── Case-scoped action history (spec §5.5 "append audit history") — mọi case
// event append một row; KHÔNG update/delete. actor có thể là user thường
// (report/appeal) hoặc admin (transition/suspend) — AuditEvent riêng chỉ dành
// cho privileged actor. ───

model ModerationAction {
  id         String            @id @default(uuid())
  caseId     String?
  moderationCase ModerationCase? @relation(fields: [caseId], references: [id])
  actorId    String?
  actor      User?             @relation("moderation_action_actor", fields: [actorId], references: [id], onDelete: SetNull)
  actionType String            // typed registry: MODERATION_ACTION_TYPES (src/lib/moderation-vocab.ts)
  targetType String?
  targetId   String?
  reasonCode String?           // bắt buộc với action type là quyết định (transition/takedown/suspend/lift/assign)
  note       String?           // đã qua redactDetail tại write time — KHÔNG chứa PII thô
  createdAt  TimestamptzString @default(now())

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
}

// ─── Blocking (spec §5.5) — directional data, symmetric enforcement; KHÔNG xóa
// message/conversation — block chỉ chặn MỚI, không phá evidence. ───

model UserBlock {
  id        String            @id @default(uuid())
  blockerId String
  blocker    User              @relation("user_block_blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked    User              @relation("user_block_blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt TimestamptzString @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─── Suspension (spec §7.8) — một row = một episode; active → lifted qua atomic
// claim; KHÔNG auto-expiry (policy duration = Ambiguity A2 — fail closed: indefinite). ───

model UserSuspension {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation("user_suspension_user", fields: [userId], references: [id], onDelete: Restrict) // explicit: xóa user đang bị đình chỉ bị chặn — account deletion là batch sau + quyết định A3
  status         suspension_status @default(active)
  reasonCode     String            // typed — SUSPENSION_REASON_CODES (src/lib/moderation-vocab.ts)
  note           String?           // đã qua redactDetail tại write time
  suspendedById  String?          // nullable + SetNull: row lịch sử sống qua admin deletion (A3)
  suspendedBy    User?             @relation("user_suspension_actor", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedAt    TimestamptzString @default(now())
  liftedById     String?
  liftedBy       User?             @relation("user_suspension_lifter", fields: [liftedById], references: [id], onDelete: SetNull)
  liftedAt       TimestamptzString?
  liftReasonCode String?

  @@index([userId, status])
  @@index([status, suspendedAt])
  // một episode active duy nhất per user — đóng race double-suspend (Task 5)
  @@index([userId], where: "(status = 'active')", unique: true, name: "user_suspension_one_active")
}

// ─── Appeal foundation (spec §9 Batch 3) — chỉ ghi nhận + state; decision workflow = A4. ───

model Appeal {
  id          String            @id @default(uuid())
  caseId      String            @unique
  moderationCase ModerationCase @relation(fields: [caseId], references: [id])
  appellantId String?           // nullable + SetNull: appeal sống qua account deletion (A3)
  appellant   User?             @relation("appeal_appellant", fields: [appellantId], references: [id], onDelete: SetNull)
  statement   String?           // lời trình bày của subject — untrusted input, cap ở action layer
  state       appeal_state      @default(submitted)
  createdAt   TimestamptzString @default(now())
  closedAt    TimestamptzString?
  updatedAt   temporal.updatedAtString()

  @@index([appellantId])
}

// ═══════════════════════════════════════════════════════════════════
// Batch 4 — Listing Quality (spec §5.6/§5.6.2/§5.6.4/§9 Batch 4)
// Additive-only: không drop/rename/repurpose model/cột/enum value nào đang có.
// ═══════════════════════════════════════════════════════════════════

// ─── Upload ownership (Batch 4 — spec §5.6.4 "ownership authorization") ───

model ListingImageUpload {
  id          String            @id @default(uuid())
  ownerUserId String
  owner       User              @relation("listing_image_upload_owner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  storageKey  String            @unique // "<uuid>.webp" — khóa ngẫu nhiên, KHÔNG dùng tên file của client
  bytes       Int
  width       Int
  height      Int
  createdAt   TimestamptzString @default(now())

  @@index([ownerUserId, createdAt])
}

// ═══════════════════════════════════════════════════════════════════
// Batch 5 — Search, Location & Telemetry (spec §5.7/§5.8/§5.9/§9 Batch 5)
// Additive-only: không drop/rename/repurpose model/cột/enum value nào đang có.
// Batch 4 owns provinceLevelCode/communeLevelCode/locationDisplayName;
// Batch 5 thêm ĐÚNG: Listing.locationSource + Listing.searchTextNormalized
// (+ full-text index language "simple") + 2 enum + ProductEvent + SearchAlias.
// ═══════════════════════════════════════════════════════════════════

// ─── Product telemetry (Batch 5, spec §5.8 — domain RIÊNG với AuditEvent của Batch 2, S10) ───

model ProductEvent {
  id             String            @id @default(uuid())
  name           String            // taxonomy (src/lib/product-events.ts) — registry trong code, KHÔNG phải enum DB
  schemaVersion  String            // "1" — PRODUCT_EVENT_SCHEMA_VERSION
  occurredAt     TimestamptzString @default(now())
  actorPseudonym String?           // HMAC-SHA256(userId, HKDF(PRODUCT_EVENT_PSEUDONYM_KEY, "product-event-actor")) — KHÔNG bao giờ id thô (S-10)
  sessionPseudonym String?         // HMAC-SHA256(UserSession.id, cùng key) — KHÔNG bao giờ session id thô (S-10:
                                  //   session id thô join thẳng về userId qua UserSession)
  pseudonymKeyVersion String       @default("1") // id của key đã ghi — phát hiện rotation (S-11)
  isInternal     Boolean           @default(false) // internal cohort ∪ adminRole ≠ null, tính LÚC emit (S-12) —
                                  //   exclusion không phụ thuộc key ổn định qua rotation
  searchSessionId String?          // uuid do server sinh cho mỗi lần search — khóa join CTR / search→chat (S-14)
  listingId      String?           // KHÔNG FK: event append-only sống qua vòng đời listing (spec §5.8)
  productModelId String?           // KHÔNG FK (như trên)
  conversationId String?          // internal id cho join response metrics — KHÔNG FK (như trên)
  provinceCode   String?           // mã tỉnh canonical — coarse location (spec §4.8), KHÔNG bao giờ địa chỉ chi tiết
  metadata       Json?             // allowlisted theo event schema (zod) — KHÔNG PII, KHÔNG query text thô (spec §4.8)

  @@index([name, occurredAt])
  @@index([actorPseudonym, occurredAt])
  @@index([searchSessionId])
  @@index([listingId])
  @@index([conversationId])
}

// ─── Search aliases (Batch 5, spec §5.7 — mechanism ở đây, CONTENT thuộc Batch 4/8 seed, A7/S9) ───

model SearchAlias {
  id             String   @id @default(uuid())
  alias          String   // dạng CHUẨN HÓA (normalizeSearchText) — khóa tra cứu, vd "soundlink"
  target         search_alias_target
  brandId        String?
  brand          Brand?       @relation("alias_brand", fields: [brandId], references: [id], onDelete: Cascade)
  productModelId String?
  productModel   ProductModel? @relation("alias_model", fields: [productModelId], references: [id], onDelete: Cascade)
  note           String?
  createdAt      TimestamptzString @default(now())

  @@unique([alias, target])
  @@index([alias])
  // target ⇒ id set (corrections item 5): một alias row trỏ đúng MỘT catalog entity
  // — target=brand ⇒ brandId set & productModelId null; target=model ⇒ ngược lại.
  // onDelete: Cascade (corrections item 16): alias là dữ liệu phụ sinh theo target —
  // seed-beta-catalog rollback xóa brand/model không bị Restrict chặn, alias trỏ
  // id đã chết là rác — cascade dọn theo.
  @@check(expression: "((target = 'brand' AND \"brandId\" IS NOT NULL AND \"productModelId\" IS NULL) OR (target = 'model' AND \"productModelId\" IS NOT NULL AND \"brandId\" IS NULL))", name: "search_alias_target_ids")
}

// ═══════════════════════════════════════════════════════════════════
// Batch 6 — Chat Hardening and Deal Outcome (spec §5.2/§9 Batch 6)
// Additive-only: không drop/rename/repurpose model/cột/enum value nào đang có.
// KHÔNG thêm giá trị listing_status nào — Batch 6 chỉ CLAIM giá trị `sold`
// đã có qua update seller-chosen trong markDealOutcomeAction (D6).
// ═══════════════════════════════════════════════════════════════════

// ─── Lightweight Deal (Batch 6, spec §5.2 — KHÔNG phải Order V2, KHÔNG đụng finance) ───
// agreedPrice là bản ghi người dùng tự nhập — LoaViet KHÔNG bao giờ thu tiền này trong P0.
// KHÔNG có trường tiền nào khác (không commission/escrow/payout/ledger — §9 Batch 6 Gate).

model Deal {
  id                 String                    @id @default(uuid())
  listingId          String?                   // nullable + SetNull theo precedent Conversation — deal sống qua listing deletion (D9)
  listing            Listing?                  @relation("deal_listing", fields: [listingId], references: [id], onDelete: SetNull)
  conversationId     String?                   // KHÔNG FK (ProductEvent.conversationId precedent) — deal reachable sau listing deletion (D9/S11)
  buyerId            String
  buyer              User                      @relation("deal_buyer", fields: [buyerId], references: [id], onDelete: Restrict) // không có account deletion trong P0 — batch sau quay lại qua retention (A7)
  sellerId           String
  seller             User                      @relation("deal_seller", fields: [sellerId], references: [id], onDelete: Restrict)
  status             deal_status               @default(open)
  agreedPrice        Int?                      // VND — bản ghi tự nhập, bound 100_000..2_000_000_000 (listing-schema PRICE_MIN/MAX — D5)
  fulfillmentMethod  deal_fulfillment_method?
  buyerOutcomeAt     TimestamptzString?        // buyer đã đánh dấu kết quả (giá trị sống trong DealStatusHistory.note)
  sellerOutcomeAt    TimestamptzString?
  completedAt        TimestamptzString?        // đặt khi claim open→completed thành công (bilateral)
  cancellationReason String?                   // ≤500 ký tự — untrusted input, render React text; KHÔNG vào telemetry
  createdAt           TimestamptzString         @default(now())
  updatedAt           temporal.updatedAtString()

  statusHistory DealStatusHistory[]

  @@index([listingId])
  @@index([conversationId])                     // panel lookup theo hội thoại — sống qua listing deletion (S11)
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, updatedAt])
  // MỘT deal OPEN duy nhất per (listing, buyer) — đóng race double-create (Task 4);
  // deal completed/cancelled/no_deal cùng cặp được phép tồn tại → buyer tạo deal MỚI sau khi deal cũ kết thúc (D4)
  @@index([listingId, buyerId], where: "(status = 'open')", unique: true, name: "deal_one_open_per_listing_buyer")
}

// Lịch sử trạng thái Deal (spec §5.2 DealStatusHistory) — APPEND-ONLY:
// không product flow nào update/delete; actor nullable + SetNull sống qua account deletion tương lai
// (Batch 3 ModerationAction precedent). note mang typed marker "buyer:success" / "seller:no_deal" + reason.
model DealStatusHistory {
  id        String            @id @default(uuid())
  dealId    String
  deal      Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  status    deal_status       // trạng thái deal SAU marking này
  actorId   String?
  actor     User?             @relation("deal_history_actor", fields: [actorId], references: [id], onDelete: SetNull)
  note      String?           // typed marker per party + cancellationReason — KHÔNG PII
  createdAt TimestamptzString @default(now())

  @@index([dealId, createdAt])
  @@index([actorId, createdAt])
}

# ─── Database (Prisma 8 / PostgreSQL ≥ 15) ───
# Dev local: container speaker-postgres, port 5435 (xem README "Chạy dự án")
DATABASE_URL="postgresql://speaker:choose-a-dev-password@localhost:5435/speaker_platform?schema=public"

# ─── Auth ───
# Session JWT secret — sinh bằng: openssl rand -hex 32
AUTH_SECRET="change-me"

# Key mã hóa TOTP secret của admin (AdminMfa) — DÀNH RIÊNG, không dùng AUTH_SECRET.
# Base64 của ĐÚNG 32 byte — sinh bằng: openssl rand -base64 32
# Bắt buộc ở production (validateEnv fail-fast khi start); dev/test có thể bỏ trống.
# Rotate key → các envelope cũ decrypt ra typed ADMIN_MFA_KEY_MISMATCH → chạy
# mfa-reset + mfa-enroll lại cho từng admin (xem docs/operations runbook).
ADMIN_MFA_ENCRYPTION_KEY=""

# ─── App ───
NEXT_PUBLIC_APP_NAME="LoaViet"
# URL công khai — MoMo redirect/IPN cần HTTPS domain thật khi production
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Rate limit / proxy trust ───
# Chỉ bật khi app KHÔNG truy cập trực tiếp từ internet (compose bind
# 127.0.0.1 + nginx proxy local). Header proxy do client tự đặt được —
# mặc định TẮT (fail-safe): mọi client chung bucket rate limit.
TRUST_PROXY_HEADERS="false"

# ─── Finance capability (private beta) ───
# Master switch SERVER-ONLY cho mọi tính năng tài chính (escrow, thanh toán,
# ví, rút tiền, hoa hồng). Mặc định/bỏ trống = "false" → mọi entry point tài
# chính bị chặn server-side với mã FINANCIAL_FEATURES_DISABLED.
# Private beta: PHẢI giữ "false" ở production — validateEnv fail-fast nếu "true".
# Chỉ set "true" ở dev/test để chạy test thuật toán finance legacy.
# Parse strict: chỉ "true" | "false". KHÔNG có biến NEXT_PUBLIC_* nào
# điều khiển được khả năng này (client không có escape hatch).
FINANCIAL_FEATURES_ENABLED="false"

# ─── Escrow ───
# Số ngày buyer có thời gian khiếu nại trước khi escrow tự giải ngân
ESCROW_AUTO_RELEASE_DAYS="7"

# ─── DB runtime (tuỳ chọn) ───
# Ngưỡng slow-query log (ms) — query chậm hơn in 1 dòng JSON scope db:slow-query
# (không log SQL/params). Bỏ trống = 500ms.
# SLOW_QUERY_MS="500"

# ─── Cron (escrow auto-release) ───
# Secret bảo vệ POST /api/cron/auto-release — sinh bằng: openssl rand -hex 32
# Thiếu → endpoint trả 503 và từ chối chạy (fail closed)
CRON_SECRET="change-me"

# ─── Seed (chỉ dev/test) ───
# Mật khẩu cho các tài khoản mẫu (admin/seller/buyer) — ≥ 8 ký tự.
# Seed từ chối chạy khi thiếu SEED_PASSWORD hoặc khi NODE_ENV=production.
SEED_PASSWORD="dev-only-password"

# ─── MoMo Payment Gateway ───
# Dev/test: credentials test từ business.momo.vn + endpoint test.
# Production: credentials thật + MOMO_ENDPOINT=https://payment.momo.vn
# Thiếu 3 credentials → createMomoPayment throw MOMO_NOT_CONFIGURED (không có fallback)
MOMO_PARTNER_CODE="your-partner-code"
MOMO_ACCESS_KEY="your-access-key"
MOMO_SECRET_KEY="your-secret-key"
MOMO_ENDPOINT="https://test-payment.momo.vn"

# ─── Docker compose production (docker-compose.prod.yml) ───
# Mật khẩu Postgres của stack production — sinh bằng: openssl rand -hex 16
# Compose từ chối start nếu thiếu (lỗi hiện ngay khi up)
DB_PASSWORD="generate-with-openssl-rand-hex-16"

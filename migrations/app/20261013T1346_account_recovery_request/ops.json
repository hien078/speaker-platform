        "description": "create table \"AccountRecoveryRequest\"",
        "sql": "CREATE TABLE \"public\".\"AccountRecoveryRequest\" (\n  \"checkListingTitle\" bool NOT NULL,\n  \"checkProvince\" bool NOT NULL,\n  \"checkRegistrationMonth\" bool NOT NULL,\n  \"checksPassed\" int4 NOT NULL,\n  \"consumedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"decidedAt\" timestamptz,\n  \"decidedById\" text,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"phoneHash\" text NOT NULL,\n  \"phoneVerifiedAtSnapshot\" timestamptz NOT NULL,\n  \"requestedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"requestedById\" text,\n  \"resetTokenExpiresAt\" timestamptz,\n  \"resetTokenHash\" text,\n  \"status\" text DEFAULT 'requested' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"AccountRecoveryRequest_status_check_8162b213\" CHECK (\"status\" IN ('requested', 'approved', 'rejected', 'cancelled', 'expired', 'consumed')),\n  CONSTRAINT \"account_recovery_checks_range_827d8d2e\" CHECK (\"checksPassed\" BETWEEN 2 AND 3)\n)",

      {
        "description": "create table \"ManualContactVerification\"",
        "sql": "CREATE TABLE \"public\".\"ManualContactVerification\" (\n  \"channel\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"decidedAt\" timestamptz,\n  \"decidedById\" text,\n  \"expiresAt\" timestamptz NOT NULL,\n  \"id\" text NOT NULL,\n  \"method\" text NOT NULL,\n  \"note\" text,\n  \"requestedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"requestedById\" text,\n  \"status\" text DEFAULT 'requested' NOT NULL,\n  \"targetHash\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"ManualContactVerification_channel_check_d360ded9\" CHECK (\"channel\" IN ('email', 'phone')),\n  CONSTRAINT \"ManualContactVerification_method_check_57528128\" CHECK (\"method\" IN ('phone_call', 'in_person', 'video_call', 'other')),\n  CONSTRAINT \"ManualContactVerification_status_check_0bb6ca3a\" CHECK (\"status\" IN ('requested', 'approved', 'rejected', 'cancelled', 'expired'))\n)",
        "params": []
